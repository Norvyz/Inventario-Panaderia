# Cadena de conexión de Supabase (PostgreSQL)
# Supabase -> Project Settings -> Database -> Connection string -> URI
#
# Copia este archivo como ".env" (sin la palabra example) SOLO para desarrollo local.
# El archivo .env NO se sube a Git (ya está en .gitignore).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
