# ===== Opción 1: PostgreSQL (Supabase en producción) =====
# Pega la cadena de conexión de Supabase (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# ===== Opción 2: MySQL (XAMPP local) =====
# Si NO defines DATABASE_URL, el backend usa MySQL con estos valores por defecto
DB_HOST=localhost
DB_PORT=3306
DB_NAME=panaderia_inventario
DB_USER=root
DB_PASS=
